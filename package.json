{
  "name": "akruti-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:create": "node db/scripts/create.mjs",
    "db:migrate": "node db/scripts/migrate.mjs",
    "db:verify": "node db/scripts/verify.mjs",
    "db:seed": "node db/scripts/seed.mjs",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "server": "node server/index.mjs",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:server\" \"npm:dev\"",
    "start": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "express": "^4.22.3",
    "lucide-react": "^0.460.0",
    "nodemailer": "^10.0.16",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.183.1",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
