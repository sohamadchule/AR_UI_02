# PostgreSQL connection string for the Akruti database (created by `npm run db:create`).
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/akruti"

# Public base URL (scheme + host, no trailing slash) the QR code points to.
# Leave unset in local dev: a localhost host is auto-replaced by this PC's LAN IP,
# so a phone on the same Wi-Fi can scan and open it. For device AR (WebXR needs HTTPS),
# run a tunnel (e.g. `cloudflared tunnel --url http://localhost:5173`) and paste its URL.
# PUBLIC_BASE_URL="https://your-tunnel.trycloudflare.com"

# Bearer token required to list demo requests via GET /api/demo-requests (unset = endpoint disabled).
# ADMIN_TOKEN="change-me"

# Outgoing mail (SMTP). Without SMTP_HOST requests are still saved but no mail is sent.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"   # true for port 465
# SMTP_USER="you@example.com"
# SMTP_PASS="app-password"
# MAIL_FROM="Akruti <no-reply@example.com>"
# Where the "new demo request" alert goes (comma-separated for several addresses).
# DEMO_NOTIFY_EMAIL="sales@example.com"
# Hours during which a repeat request (same email + interest) gets no confirmation mail. Default 24.
# DEMO_MAIL_COOLDOWN_HOURS="24"
